# ============ REQUIRED ============
DATABASE_URL=postgresql://crawlseo:changeme@localhost:5432/crawlseo
APP_SECRET=change-me-to-random-string
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=change-me-to-a-separate-random-string
# Generate with: openssl rand -hex 32; do not reuse NEXTAUTH_SECRET

# ============ DOCKER COMPOSE DB CREDENTIALS ============
# These are referenced by docker-compose.yml — set your own for non-local deployments.
POSTGRES_USER=crawlseo
POSTGRES_PASSWORD=changeme
POSTGRES_DB=crawlseo

# ============ GOOGLE OAUTH (required for GSC data) ============
# Get these from: https://console.cloud.google.com/
# Required scopes: openid, email, profile, webmasters.readonly, analytics.readonly
GOOGLE_CLIENT_ID=your-client-id-here
GOOGLE_CLIENT_SECRET=your-client-secret-here
# Production callback, also add this exact URI in Google Cloud Console.
# GOOGLE_OAUTH_REDIRECT_URI=https://crawlseo.helloada.app/api/auth/callback/google

# Optional: PageSpeed Insights API key (higher quota for Core Web Vitals)
# GOOGLE_PAGESPEED_KEY=

# ============ NEXTAUTH / AUTH.JS ============
# Production (Vercel): set to https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-hex-32
# AUTH_SECRET works as alias for Auth.js v5
# AUTH_SECRET=

# ============ OPTIONAL: Scheduling ============
# Cron format: "minute hour day-of-month month day-of-week"
# CRAWL_SCHEDULE=0 0 * * 0                    # Weekly Sunday midnight
# GSC_SYNC_SCHEDULE=0 2 * * *                 # Daily 2am UTC
# VITALS_SCHEDULE=0 3 * * 0                   # Weekly Sunday 3am UTC

# ============ OPTIONAL: PLATFORM DATAFORSEO ============
# One account-level API credential is encrypted and automatically granted to
# every provisioned CrawlSEO project. DataForSEO does not expose provider-side
# project/subaccount creation through its REST API; project isolation is kept
# in CrawlSEO's database and task/report boundaries.
# Use the API credentials from https://app.dataforseo.com/api-access, not the
# DataForSEO dashboard password.
# CRAWLSEO_DATAFORSEO_LOGIN=your-dataforseo-api-login
# CRAWLSEO_DATAFORSEO_PASSWORD=your-dataforseo-api-password

# ============ OPTIONAL: Registration ============
# Set to true after creating your admin account to prevent new registrations
# DISABLE_REGISTRATION=false

# ============ OPTIONAL: Email Notifications ============
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=alerts@crawlseo.dev

# ============ OPTIONAL: Telegram Notifications ============
# Get from: https://t.me/BotFather
# TELEGRAM_BOT_TOKEN=your-bot-token-here

# ============ OPTIONAL: Slack Notifications ============
# Create at: https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============ OPTIONAL: CrawlSEO MCP / durable worker ============
# Project provisioning uses a Workspace user for Search Console via service-account
# domain-wide delegation. Add that user to the GSC property before provisioning.
# For an existing personal Google account with stored OAuth access, use this
# instead; do not set both OAuth and service-account GSC modes.
# CRAWLSEO_GOOGLE_OAUTH_USER_EMAIL=existing-google-user@example.com
# CRAWLSEO_GOOGLE_IMPERSONATED_USER_EMAIL=seo-automation@your-workspace.example
# CRAWLSEO_GOOGLE_SERVICE_ACCOUNT_FILE=/secure/path/google-service-account.json
# HELLOADA_ORGANIZATION_ID=your-organization-id
# HELLOADA_PROJECT_ID=oceanicvibes
# CRAWLSEO_PROVISIONING_IDEMPOTENCY_KEY=oceanicvibes-site-agent-v1
# CRAWLSEO_GA4_PROPERTY_ID=551030734
# CRAWLSEO_GSC_PROPERTY=https://oceanicvibes.com/
# CRAWLSEO_DOMAIN_VERIFICATION_METHOD=verified_gsc
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3006
# MCP_ALLOWED_HOSTS=crawlseo.helloada.app,127.0.0.1,localhost
# MCP_MAX_REQUEST_BYTES=2097152
# MCP_MAX_RESPONSE_BYTES=2097152
# JOB_WORKER_POLL_MS=1000
# JOB_WORKER_LEASE_SECONDS=120

# ============ NODE ENVIRONMENT ============
# NODE_ENV=development
