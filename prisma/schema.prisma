generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ AUTH ============

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  googleTokens  Json? // User OAuth tokens; project credentials use GoogleConnection
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  sites    Site[]
  alerts   Alert[]
  apiKeys  ApiKey[]
}

// ============ HELLOADA TENANCY ==========

model Workspace {
  id                     String          @id @default(cuid())
  externalOrganizationId String          @unique
  name                   String
  status                 WorkspaceStatus @default(ACTIVE)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  projects    Project[]
  connections GoogleConnection[]
}

model Project {
  id                             String        @id @default(cuid())
  workspaceId                    String
  externalProjectId              String
  name                           String
  status                         ProjectStatus @default(ACTIVE)
  createdAt                      DateTime      @default(now())
  updatedAt                      DateTime      @updatedAt
  monthlyResearchAllowanceMicros BigInt?
  maxResearchOperationMicros     BigInt?
  researchBudgetCurrency         String        @default("USD")
  researchBudgetTimeZone         String        @default("UTC")
  researchBudgetRevision         Int           @default(1)

  workspace                  Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sites                      Site[]
  integrationGrants          IntegrationGrant[]
  servicePrincipals          ServicePrincipal[]
  jobs                       Job[]
  dataforseoGrants           ProjectApiKeyGrant[]
  seoResearchPolicies        SeoResearchPolicy[]
  seoResearchRuns            SeoResearchRun[]
  articleKeywordResearchRuns ArticleKeywordResearchRun[]
  siteProfiles               SiteProfile[]
  researchRuns               ResearchRun[]
  researchActions            ResearchAction[]
  connectorBindings          ConnectorBinding[]
  connectorBindingTransfers  ConnectorBindingTransfer[]
  connectorContexts          ConnectorContextSnapshot[]
  connectorEvents            ConnectorEvent[]
  connectorOperationReceipts ConnectorOperationReceipt[]
  connectorExecutionStates   ConnectorExecutionState[]
  connectorEventCounter      ConnectorEventCounter?
  researchBudgetReservations ResearchBudgetReservation[]
  legacyBudgetImportsFrom    LegacyBudgetImportReceipt[] @relation("LegacyBudgetImportSourceProject")
  legacyBudgetImportsTo      LegacyBudgetImportReceipt[] @relation("LegacyBudgetImportTargetProject")
  legacyBudgetFreezesFrom    LegacyBudgetSourceFreezeReceipt[] @relation("LegacyBudgetFreezeSourceProject")
  legacyBudgetFreezesTo      LegacyBudgetSourceFreezeReceipt[] @relation("LegacyBudgetFreezeTargetProject")

  @@unique([workspaceId, externalProjectId])
  @@index([workspaceId])
}

enum ConnectorBindingStatus {
  ACTIVE
  PAUSED
  TRANSFERRING
}

// Exactly one active executor can own a site. Generation fences stale workers
// and status callbacks when an installation is deliberately transferred.
model ConnectorBinding {
  id         String                 @id @default(cuid())
  projectId  String
  siteId     String                 @unique
  executor   String
  generation Int                    @default(1)
  status     ConnectorBindingStatus @default(ACTIVE)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

model ConnectorBindingTransfer {
  id             String   @id @default(cuid())
  projectId      String
  siteId         String
  idempotencyKey String
  requestHash    String
  fromExecutor   String
  toExecutor     String
  fromGeneration Int
  toGeneration   Int
  reason         String
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([projectId, idempotencyKey])
  @@index([projectId, siteId, createdAt])
}

// The connector pushes a revisioned snapshot; CrawlSEO never treats a crawl
// as canonical inventory or owner-confirmed business context.
model ConnectorContextSnapshot {
  id               String   @id @default(cuid())
  projectId        String
  siteId           String   @unique
  revision         String
  websiteInventory Json
  businessFacts    Json
  capabilities     Json
  canonicalOrigin  String
  observedAt       DateTime
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ConnectorEventCounter {
  projectId String @id
  sequence  Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Durable pull-based outbox. Acknowledgement means receipt only; publication
// success is a separate verified event carrying its receipt.
model ConnectorEvent {
  id             String    @id
  projectId      String
  siteId         String
  sequence       Int
  actionId       String?
  actionRevision Int?
  type           String
  payload        Json
  occurredAt     DateTime  @default(now())
  acknowledgedAt DateTime?
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  lastError      String?
  createdAt      DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([projectId, sequence])
  @@index([projectId, acknowledgedAt, sequence])
  @@index([siteId, actionId, actionRevision])
}

model ConnectorOperationReceipt {
  id             String   @id @default(cuid())
  projectId      String
  siteId         String
  actionId       String
  actionRevision Int
  operation      String
  idempotencyKey String
  requestHash    String
  result         Json
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([projectId, operation, idempotencyKey])
  @@index([projectId, actionId, actionRevision])
}

model ConnectorExecutionState {
  id                 String    @id @default(cuid())
  projectId          String
  siteId             String
  actionId           String
  actionRevision     Int
  generation         Int
  status             String
  candidateRef       String?
  reviewUrl          String?
  reviewPackageHash  String?
  ownerDecision      String?
  publicationReceipt Json?
  verifiedAt         DateTime?
  observedAt         DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([actionId, actionRevision])
  @@index([projectId, siteId, observedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============ API KEYS (BYOK) ============

model ApiKey {
  id                String   @id @default(cuid())
  userId            String
  provider          String // "dataforseo"
  encryptedLogin    String
  encryptedPassword String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectGrants ProjectApiKeyGrant[]

  @@unique([userId, provider])
}

// Platform-managed provider credentials are kept separate from user BYOK keys.
// DataForSEO is account-scoped, so one platform credential may be granted to
// many isolated CrawlSEO projects without exposing it to users.
model ProviderCredential {
  id                String                   @id @default(cuid())
  provider          String
  label             String
  encryptedLogin    String
  encryptedPassword String
  status            ProviderCredentialStatus @default(ACTIVE)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  projectGrants ProjectApiKeyGrant[]

  @@unique([provider, label])
  @@index([provider, status])
}

model ProjectApiKeyGrant {
  id                   String                   @id @default(cuid())
  projectId            String
  apiKeyId             String?
  providerCredentialId String?
  provider             String                   @default("dataforseo")
  status               ProjectApiKeyGrantStatus @default(ACTIVE)
  lastValidatedAt      DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apiKey             ApiKey?             @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  providerCredential ProviderCredential? @relation(fields: [providerCredentialId], references: [id], onDelete: Cascade)

  @@unique([projectId, provider])
  @@index([apiKeyId, status])
  @@index([providerCredentialId, status])
}

model SeoResearchPolicy {
  id                       String   @id @default(cuid())
  projectId                String
  siteId                   String
  enabled                  Boolean  @default(true)
  monthlyTaskLimit         Int      @default(9)
  keywordSeedLimit         Int      @default(5)
  competitorLimit          Int      @default(1)
  packageVersion           String   @default("standard-v1")
  articleResearchEnabled   Boolean  @default(true)
  articleTaskLimitPerMonth Int      @default(5)
  articleMinIntervalDays   Int      @default(7)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId])
  @@index([projectId, enabled])
}

model ArticleKeywordResearchRun {
  id                   String                       @id @default(cuid())
  projectId            String
  siteId               String
  ideaKey              String
  ideaSummary          String
  idempotencyKey       String
  requestHash          String
  seed                 String
  queries              Json?
  kind                 ArticleKeywordResearchKind   @default(RELATED_KEYWORDS)
  parentRunId          String?                      @unique
  language             String
  country              String
  providerLanguageCode String?
  providerLocationCode Int?
  status               ArticleKeywordResearchStatus @default(REQUESTED)
  providerTaskId       String?
  costMicros           Int?
  result               Json?
  errorCode            String?
  requestedAt          DateTime                     @default(now())
  attemptedAt          DateTime?
  completedAt          DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  project   Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site      Site                       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parentRun ArticleKeywordResearchRun? @relation("ArticleResearchSerp", fields: [parentRunId], references: [id], onDelete: Cascade)
  serpRun   ArticleKeywordResearchRun? @relation("ArticleResearchSerp")

  @@unique([siteId, idempotencyKey])
  @@index([projectId, createdAt])
  @@index([siteId, ideaKey])
  @@index([siteId, requestedAt])
}

model SeoResearchRun {
  id                  String               @id @default(cuid())
  projectId           String
  siteId              String
  periodStart         DateTime
  idempotencyKey      String
  brief               Json
  briefHash           String
  packageVersion      String
  reportSchemaVersion Int                  @default(1)
  status              SeoResearchRunStatus @default(REQUESTED)
  taskLimit           Int
  taskCount           Int                  @default(0)
  attemptedCount      Int                  @default(0)
  actualCostMicros    Int                  @default(0)
  report              Json?
  sourceManifest      Json?
  errorCode           String?
  requestedAt         DateTime             @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  project Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site    Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tasks   SeoResearchTask[]

  @@unique([siteId, periodStart, packageVersion])
  @@unique([siteId, idempotencyKey])
  @@index([projectId, status, periodStart])
}

model SeoResearchTask {
  id             String                @id @default(cuid())
  researchRunId  String
  operationKey   String
  kind           SeoResearchTaskKind
  ordinal        Int?
  input          Json
  requestHash    String
  status         SeoResearchTaskStatus @default(RESERVED)
  providerTaskId String?
  costMicros     Int?
  result         Json?
  errorCode      String?
  attemptedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  researchRun SeoResearchRun @relation(fields: [researchRunId], references: [id], onDelete: Cascade)

  @@unique([researchRunId, operationKey])
  @@index([researchRunId, status])
}

// ============ CONTENT STUDIO ============

model ContentDraft {
  id              String             @id @default(cuid())
  siteId          String
  actionId        String?
  opportunityKey  String
  actionKind      String
  format          String
  primaryQuery    String             @default("")
  targetUrl       String?
  intent          String
  title           String
  slug            String
  metaTitle       String
  metaDescription String
  excerpt         String
  markdown        String
  outline         Json?
  brief           Json
  model           String
  provider        String
  status          ContentDraftStatus @default(READY)
  wixApprovalHash String?
  wixApprovedBy   String?
  wixApprovedAt   DateTime?
  wixApprovedRevision Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  site       Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  action     ResearchAction? @relation(fields: [actionId], references: [id], onDelete: SetNull)
  deliveries Delivery[]
  agentTasks AgentTask[]

  @@index([siteId, createdAt])
  @@index([siteId, opportunityKey])
  @@index([siteId, status])
  @@index([actionId])
}

enum ContentDraftStatus {
  READY
  ARCHIVED
}

// ============ RESEARCH ENGINE ============

model SiteProfile {
  id          String   @id @default(cuid())
  siteId      String   @unique
  projectId   String?
  language    String   @default("en")
  country     String?
  audience    Json?
  topics      Json?
  services    Json?
  competitors Json?
  brandVoice  String?
  constraints Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site    Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model ResearchRun {
  id            String            @id @default(cuid())
  siteId        String
  projectId     String?
  scheduleKey   String?
  kind          ResearchRunKind   @default(MARKET)
  trigger       ResearchTrigger   @default(MANUAL)
  status        ResearchRunStatus @default(QUEUED)
  title         String
  brief         Json
  topics        Json?
  recencyDays   Int               @default(90)
  policyRevision Int?
  providerSet   Json?
  promptVersion String            @default("research-v1")
  model         String?
  report        Json?
  sourceCount   Int               @default(0)
  findingCount  Int               @default(0)
  actionCount   Int               @default(0)
  costMicros    Int               @default(0)
  errorCode     String?
  requestedBy   String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  site     Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  project  Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sources  ResearchSource[]
  findings ResearchFinding[]
  actions  ResearchAction[]

  @@index([siteId, createdAt])
  @@index([siteId, status])
  @@index([projectId, createdAt])
  @@unique([siteId, scheduleKey])
}

model ResearchSource {
  id          String    @id @default(cuid())
  runId       String
  provider    String
  url         String
  title       String?
  author      String?
  community   String?
  publishedAt DateTime?
  retrievedAt DateTime  @default(now())
  excerpt     String?
  contentHash String?
  language    String?
  metadata    Json?
  createdAt   DateTime  @default(now())

  run ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, contentHash])
  @@index([runId, provider])
}

model ResearchFinding {
  id                  String              @id @default(cuid())
  runId               String
  type                ResearchFindingType
  theme               String
  summary             String
  confidence          Int                 @default(50)
  sentiment           String?
  urgency             String?
  evidenceSourceIds   Json?
  suggestedActionKind String?
  createdAt           DateTime            @default(now())

  run     ResearchRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  actions ResearchAction[]

  @@index([runId, type])
}

model ResearchAction {
  id                     String               @id @default(cuid())
  siteId                 String
  projectId              String?
  revision               Int                  @default(1)
  runId                  String?
  findingId              String?
  source                 String
  kind                   String
  format                 String?
  title                  String
  primaryQuery           String?
  targetUrl              String?
  recommendation         String
  priorityRationale      String?
  evidence               Json?
  requiredCapabilities   Json?
  acceptanceCriteria     Json?
  dependencies           Json?
  reassessmentConditions Json?
  priority               Int                  @default(50)
  preparationStatus      PreparationStatus    @default(NONE)
  preparationRequestId   String?
  status                 ResearchActionStatus @default(PROPOSED)
  automationMode         AutomationMode       @default(MANUAL)
  dedupeKey              String
  owner                  String?
  approvedBy             String?
  approvedAt             DateTime?
  deliveredAt            DateTime?
  verifiedAt             DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  site       Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  project    Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run        ResearchRun?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  finding    ResearchFinding? @relation(fields: [findingId], references: [id], onDelete: SetNull)
  drafts     ContentDraft[]
  deliveries Delivery[]
  agentTasks AgentTask[]

  @@unique([siteId, dedupeKey])
  @@index([siteId, status, priority])
  @@index([projectId, status, priority])
  @@index([siteId, createdAt])
}

model LegacyBudgetImportReceipt {
  id                 String   @id
  sourceProjectId    String
  sourceSiteId       String
  targetProjectId    String
  targetSiteId       String
  idempotencyKey     String
  requestHash        String
  sourceEvidenceHash String
  reservationIds    Json
  snapshot           Json
  createdAt          DateTime @default(now())

  sourceProject Project @relation("LegacyBudgetImportSourceProject", fields: [sourceProjectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceSite    Site    @relation("LegacyBudgetImportSourceSite", fields: [sourceSiteId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetProject Project @relation("LegacyBudgetImportTargetProject", fields: [targetProjectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetSite    Site    @relation("LegacyBudgetImportTargetSite", fields: [targetSiteId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([targetProjectId, idempotencyKey])
  @@index([sourceProjectId, createdAt])
}

model LegacyBudgetSourceFreezeReceipt {
  id               String   @id
  sourceProjectId  String
  sourceSiteId     String
  targetProjectId  String
  targetSiteId     String
  idempotencyKey   String
  reason           String
  requestHash      String
  sourcePolicyHash String
  snapshot         Json
  createdAt        DateTime @default(now())

  sourceProject Project @relation("LegacyBudgetFreezeSourceProject", fields: [sourceProjectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceSite    Site    @relation("LegacyBudgetFreezeSourceSite", fields: [sourceSiteId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetProject Project @relation("LegacyBudgetFreezeTargetProject", fields: [targetProjectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetSite    Site    @relation("LegacyBudgetFreezeTargetSite", fields: [targetSiteId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([sourceProjectId, idempotencyKey])
  @@index([sourceProjectId, createdAt])
}

model Delivery {
  id                String    @id @default(cuid())
  actionId          String
  draftId           String?
  platform          String
  externalId        String?
  status            String
  payload           Json?
  diff              Json?
  errorCode         String?
  outcome           Json?
  outcomeMeasuredAt DateTime?
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  action ResearchAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  draft  ContentDraft?  @relation(fields: [draftId], references: [id], onDelete: SetNull)

  @@index([actionId, createdAt])
}

enum ResearchRunKind {
  MARKET
  SEO
  MIXED
}

enum ResearchTrigger {
  MANUAL
  SCHEDULED
  API
}

enum ResearchRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum ResearchFindingType {
  THEME
  QUESTION
  CONCERN
  OBJECTION
  TREND
  MISCONCEPTION
  CONTENT_GAP
}

enum ResearchActionStatus {
  PROPOSED
  APPROVED
  DISMISSED
  DRAFTING
  DRAFT_READY
  DELIVERY_APPROVED
  DELIVERING
  DELIVERED
  VERIFIED
  FAILED
}

enum PreparationStatus {
  NONE
  ELIGIBLE
  QUEUED
  READY
  BLOCKED
  CANCELLED
}

enum AutomationMode {
  MANUAL
  ASSISTED
  AUTOMATIC
}

// ============ AGENT TASKS ============

model AgentTask {
  id                  String          @id @default(cuid())
  siteId              String
  actionId            String?
  actionRevision      Int?
  connectorGeneration Int?
  draftId             String?
  kind                String
  status              AgentTaskStatus @default(READY)
  title               String
  goal                String
  prompt              String
  repoPath            String
  route               String?
  branch              String?
  worktreePath        String?
  agent               String          @default("opencode")
  opencodeSessionId   String?
  commitSha           String?
  bridgeReceiptId     String?
  publishedUrl        String?
  result              Json?
  errorCode           String?
  startedAt           DateTime?
  completedAt         DateTime?
  closedAt            DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  site      Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  action    ResearchAction?     @relation(fields: [actionId], references: [id], onDelete: SetNull)
  draft     ContentDraft?       @relation(fields: [draftId], references: [id], onDelete: SetNull)
  messages  AgentTaskMessage[]
  artifacts AgentTaskArtifact[]

  @@unique([actionId, actionRevision])
  @@index([siteId, createdAt])
  @@index([actionId])
  @@index([status, createdAt])
}

enum AgentTaskStatus {
  READY
  RUNNING
  AWAITING_REVIEW
  CHANGES_REQUESTED
  APPROVED
  COMMITTED
  PUBLISHING
  PUBLISHED
  CLOSED
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentMessageRole {
  HUMAN
  AGENT
  SYSTEM
}

// ============ RESEARCH POLICY / DELIVERY CONFIG ============

model ResearchPolicy {
  id            String   @id @default(cuid())
  siteId        String   @unique
  enabled       Boolean  @default(true)
  cadence       String   @default("weekly")
  providers     Json?
  goals         Json?
  exclusions    Json?
  recencyDays   Int      @default(90)
  maxSources    Int      @default(30)
  monthlyBudget Int      @default(9)
  autoDraft     Boolean  @default(false)
  autoAgent     Boolean  @default(false)
  revision      Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

enum ResearchBudgetReservationStatus {
  RESERVED
  SETTLED
  RELEASED
  UNCERTAIN
}

model ResearchBudgetReservation {
  id               String                          @id @default(cuid())
  projectId        String
  siteId           String
  idempotencyKey   String
  period           String
  timeZone         String
  policyRevision   Int
  amountMicros     BigInt
  actualCostMicros BigInt?
  currency         String
  operation        String
  status           ResearchBudgetReservationStatus @default(RESERVED)
  providerTaskId   String?
  detail           Json?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  settledAt        DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([projectId, idempotencyKey])
  @@index([projectId, period, status])
  @@index([siteId, createdAt])
}

model SiteDeliveryConfig {
  id          String   @id @default(cuid())
  siteId      String   @unique
  bridgeAlias String
  adapters    Json?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model AgentTaskMessage {
  id        String           @id @default(cuid())
  taskId    String
  role      AgentMessageRole
  content   String
  metadata  Json?
  createdAt DateTime         @default(now())

  task AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model AgentTaskArtifact {
  id        String   @id @default(cuid())
  taskId    String
  kind      String
  content   String?
  url       String?
  createdAt DateTime @default(now())

  task AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, kind])
}

model DeliveryTarget {
  id           String   @id @default(cuid())
  siteId       String
  key          String
  kind         String
  adapter      String
  componentTag String?
  snippetId    String?
  sourcePath   String?
  route        String?
  enabled      Boolean  @default(true)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, key])
  @@index([siteId, adapter])
}

// ============ SITES ============

model Site {
  id                       String   @id @default(cuid())
  userId                   String?
  projectId                String?
  domain                   String // e.g. "brandson.digital"
  gscProperty              String? // e.g. "sc-domain:brandson.digital"
  domainVerificationMethod String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user                       User?                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project                    Project?                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  keywords                   Keyword[]
  pages                      Page[]
  crawls                     Crawl[]
  vitals                     VitalsReport[]
  alerts                     Alert[]
  savedKeywords              SavedKeyword[]
  rankSnapshots              RankSnapshot[]
  integrationGrants          IntegrationGrant[]
  analyticsSnapshots         AnalyticsSnapshot[]
  jobs                       Job[]
  syncRuns                   SyncRun[]
  seoResearchPolicies        SeoResearchPolicy[]
  seoResearchRuns            SeoResearchRun[]
  articleKeywordResearchRuns ArticleKeywordResearchRun[]
  siteProfile                SiteProfile?
  researchRuns               ResearchRun[]
  contentDrafts              ContentDraft[]
  researchActions            ResearchAction[]
  agentTasks                 AgentTask[]
  researchPolicy             ResearchPolicy?
  siteDeliveryConfig         SiteDeliveryConfig?
  deliveryTargets            DeliveryTarget[]
  connectorBinding           ConnectorBinding?
  connectorBindingTransfers  ConnectorBindingTransfer[]
  connectorContext           ConnectorContextSnapshot?
  connectorEvents            ConnectorEvent[]
  connectorOperationReceipts ConnectorOperationReceipt[]
  connectorExecutionStates   ConnectorExecutionState[]
  researchBudgetReservations ResearchBudgetReservation[]
  legacyBudgetImportsFrom    LegacyBudgetImportReceipt[] @relation("LegacyBudgetImportSourceSite")
  legacyBudgetImportsTo      LegacyBudgetImportReceipt[] @relation("LegacyBudgetImportTargetSite")
  legacyBudgetFreezesFrom    LegacyBudgetSourceFreezeReceipt[] @relation("LegacyBudgetFreezeSourceSite")
  legacyBudgetFreezesTo      LegacyBudgetSourceFreezeReceipt[] @relation("LegacyBudgetFreezeTargetSite")

  @@unique([userId, domain])
  @@unique([projectId, domain])
  @@index([projectId])
}

// ============ GSC DATA ============

model Keyword {
  id          String   @id @default(cuid())
  siteId      String
  query       String // The search query
  date        DateTime // Date of the data point
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)
  page        String   @default("") // Landing page URL
  device      String   @default("") // DESKTOP, MOBILE, TABLET
  country     String   @default("") // Country code

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, query, date, page, device, country])
  @@index([siteId, date])
  @@index([siteId, query, date])
}

// ============ GOOGLE INTEGRATIONS ==========

model GoogleConnection {
  id                   String                 @id @default(cuid())
  workspaceId          String
  type                 GoogleConnectionType
  status               GoogleConnectionStatus @default(ACTIVE)
  label                String
  encryptedCredentials String
  scopes               Json
  metadata             Json
  expiresAt            DateTime?
  lastUsedAt           DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  grants    IntegrationGrant[]

  @@unique([workspaceId, type, label])
  @@index([workspaceId, status])
}

model IntegrationGrant {
  id                 String                 @id @default(cuid())
  connectionId       String
  projectId          String
  siteId             String?
  provider           IntegrationProvider
  externalResourceId String
  metadata           Json
  status             IntegrationGrantStatus @default(UNVERIFIED)
  lastValidatedAt    DateTime?
  lastSuccessfulAt   DateTime?
  safeErrorCode      String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  connection GoogleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site       Site?            @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // Uniqueness is enforced by partial indexes in SQL so the same external
  // resource (e.g. a shared GA4 property) can be granted per site while a
  // project-level grant (siteId NULL) stays unique.
  @@index([connectionId, projectId, provider, externalResourceId], map: "IntegrationGrant_conn_project_provider_resource_idx")
  @@index([projectId, provider, status])
}

model ServicePrincipal {
  id        String                 @id @default(cuid())
  projectId String
  name      String
  status    ServicePrincipalStatus @default(ACTIVE)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  credentials ServiceCredential[]

  @@unique([projectId, name])
}

model ServiceCredential {
  id                     String    @id @default(cuid())
  servicePrincipalId     String
  tokenPrefix            String
  tokenHash              String    @unique
  issuanceIdempotencyKey String    @unique
  issuanceRequestHash    String?
  scopes                 Json
  expiresAt              DateTime?
  lastUsedAt             DateTime?
  revokedAt              DateTime?
  secretDeliveredAt      DateTime?
  createdAt              DateTime  @default(now())

  servicePrincipal ServicePrincipal @relation(fields: [servicePrincipalId], references: [id], onDelete: Cascade)

  @@index([servicePrincipalId, revokedAt])
}

model AnalyticsSnapshot {
  id          String                  @id @default(cuid())
  siteId      String
  source      AnalyticsSnapshotSource
  periodStart DateTime
  periodEnd   DateTime
  capturedAt  DateTime                @default(now())
  data        Json
  syncRunId   String?

  site    Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  syncRun SyncRun? @relation(fields: [syncRunId], references: [id], onDelete: SetNull)

  @@unique([siteId, source, periodStart, periodEnd])
  @@index([siteId, capturedAt])
}

// ============ DURABLE JOBS ==========

model Job {
  id             String    @id @default(cuid())
  projectId      String?
  siteId         String
  kind           JobKind
  status         JobStatus @default(PENDING)
  payload        Json
  idempotencyKey String
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  nextAttemptAt  DateTime  @default(now())
  leaseOwner     String?
  leaseExpiresAt DateTime?
  heartbeatAt    DateTime?
  lastErrorCode  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project  Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site     Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  syncRuns SyncRun[]

  @@unique([siteId, kind, idempotencyKey])
  @@index([projectId, status, nextAttemptAt])
  @@index([status, nextAttemptAt])
}

model SyncRun {
  id         String     @id @default(cuid())
  jobId      String
  siteId     String
  source     SyncSource
  status     SyncStatus @default(PENDING)
  startedAt  DateTime?
  finishedAt DateTime?
  attempt    Int
  errorCode  String?
  errorText  String?
  metadata   Json
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  job       Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  site      Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  analytics AnalyticsSnapshot[]

  @@unique([jobId, attempt])
  @@index([siteId, source, createdAt])
}

model Page {
  id          String   @id @default(cuid())
  siteId      String
  url         String
  date        DateTime
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, url, date])
  @@index([siteId, date])
  @@index([siteId, url, date])
}

// ============ SAVED KEYWORDS ============

model SavedKeyword {
  id        String   @id @default(cuid())
  siteId    String
  query     String
  notes     String?
  createdAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, query])
  @@index([siteId])
}

// ============ RANK TRACKING ============

model RankSnapshot {
  id          String   @id @default(cuid())
  siteId      String
  query       String
  position    Float
  clicks      Int      @default(0)
  impressions Int      @default(0)
  page        String?
  date        DateTime

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, query, date])
  @@index([siteId, date])
  @@index([siteId, query, date])
}

// ============ CRAWLER ============

model Crawl {
  id          String      @id @default(cuid())
  siteId      String
  status      CrawlStatus @default(PENDING)
  startedAt   DateTime?
  finishedAt  DateTime?
  pagesFound  Int         @default(0)
  issuesFound Int         @default(0)
  healthScore Int? // 0-100
  maxPages    Int         @default(200)

  site       Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  issues     CrawlIssue[]
  auditPages AuditPage[]
  auditLinks AuditLink[]

  @@index([siteId, startedAt])
}

enum CrawlStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ============ AUDIT PAGE DATA ============

model AuditPage {
  id          String  @id @default(cuid())
  crawlId     String
  url         String
  statusCode  Int
  redirectUrl String?

  title       String?
  description String?
  canonical   String?
  robotsMeta  String?

  h1Count   Int   @default(0)
  h1s       Json? // Array of H1 text
  wordCount Int   @default(0)

  imageCount       Int @default(0)
  imagesMissingAlt Int @default(0)

  internalLinks Int @default(0)
  externalLinks Int @default(0)

  hasSchema    Boolean @default(false)
  hreflangTags Json? // Array of hreflang values

  contentScore Int     @default(0) // 0-100
  contentHash  String? // SHA-256 of body text

  responseTimeMs Int     @default(0)
  byteSize       Int     @default(0)
  indexable      Boolean @default(true)

  crawl Crawl @relation(fields: [crawlId], references: [id], onDelete: Cascade)

  @@index([crawlId])
  @@index([crawlId, url])
}

// ============ AUDIT LINK GRAPH ============

model AuditLink {
  id         String  @id @default(cuid())
  crawlId    String
  sourceUrl  String
  targetUrl  String
  anchorText String?
  isInternal Boolean @default(true)
  isNofollow Boolean @default(false)
  statusCode Int?

  crawl Crawl @relation(fields: [crawlId], references: [id], onDelete: Cascade)

  @@index([crawlId])
  @@index([crawlId, sourceUrl])
}

model CrawlIssue {
  id       String        @id @default(cuid())
  crawlId  String
  url      String
  type     IssueType
  severity IssueSeverity
  message  String
  details  Json? // Additional context

  crawl Crawl @relation(fields: [crawlId], references: [id], onDelete: Cascade)

  @@index([crawlId, type])
}

enum IssueType {
  BROKEN_LINK // 404, 500, etc.
  REDIRECT // 301, 302 chains
  MISSING_TITLE // No <title> tag
  MISSING_DESCRIPTION // No meta description
  DUPLICATE_TITLE // Same title on multiple pages
  DUPLICATE_DESCRIPTION // Same description on multiple pages
  MISSING_H1 // No H1 heading
  MULTIPLE_H1 // More than one H1
  MISSING_ALT // Images without alt text
  MISSING_CANONICAL // No canonical tag
  MISSING_ROBOTS // No robots.txt
  MISSING_SITEMAP // No sitemap.xml
  MISSING_SCHEMA // No structured data
  SLOW_PAGE // Load time > 3s
  MIXED_CONTENT // HTTP resources on HTTPS page
  LARGE_PAGE // Page size > 3MB
}

enum IssueSeverity {
  CRITICAL
  WARNING
  INFO
}

// ============ CORE WEB VITALS ============

model VitalsReport {
  id     String   @id @default(cuid())
  siteId String
  url    String
  date   DateTime @default(now())
  device String // MOBILE or DESKTOP

  // Core Web Vitals
  lcp Float? // Largest Contentful Paint (seconds)
  fid Float? // First Input Delay (milliseconds)
  cls Float? // Cumulative Layout Shift (score)
  inp Float? // Interaction to Next Paint (milliseconds)

  // Performance
  perfScore  Int? // 0-100 Lighthouse performance score
  speedIndex Float? // Speed Index (seconds)
  ttfb       Float? // Time to First Byte (seconds)

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, date])
  @@index([siteId, url, date])
}

// ============ ALERTS ============

model Alert {
  id        String       @id @default(cuid())
  userId    String
  siteId    String
  type      AlertType
  channel   AlertChannel
  config    Json // Thresholds, webhook URL, etc.
  enabled   Boolean      @default(true)
  lastFired DateTime?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

enum AlertType {
  TRAFFIC_DROP // Clicks dropped > X%
  POSITION_CHANGE // Keyword position changed > X
  NEW_404 // New broken links detected
  VITALS_DEGRADED // Core Web Vitals got worse
  CRAWL_ISSUES // New crawl issues detected
}

enum AlertChannel {
  EMAIL
  TELEGRAM
  WEBHOOK
  SLACK
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
}

enum ProjectStatus {
  ACTIVE
  SUSPENDED
  DELETING
}

enum GoogleConnectionType {
  SERVICE_ACCOUNT
  OAUTH
  PLATFORM_MANAGED
}

enum GoogleConnectionStatus {
  ACTIVE
  NEEDS_REAUTH
  REVOKED
  ERROR
}

enum IntegrationProvider {
  GOOGLE_SEARCH_CONSOLE
  GOOGLE_ANALYTICS
}

enum IntegrationGrantStatus {
  ACTIVE
  UNVERIFIED
  ERROR
  REVOKED
}

enum ServicePrincipalStatus {
  ACTIVE
  REVOKED
}

enum AnalyticsSnapshotSource {
  GA4
}

enum JobKind {
  GSC_SYNC
  GA4_SYNC
  CRAWL
  VITALS_SYNC
  SEO_RESEARCH
  ARTICLE_KEYWORD_RESEARCH
  RESEARCH_RUN
  AGENT_TASK
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum SyncSource {
  GSC
  GA4
  CRAWL
  VITALS
  DATAFORSEO
  RESEARCH
  AGENT
}

enum SyncStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ProjectApiKeyGrantStatus {
  ACTIVE
  REVOKED
  ERROR
}

enum ProviderCredentialStatus {
  ACTIVE
  REVOKED
  ERROR
}

enum SeoResearchRunStatus {
  REQUESTED
  WAITING_FOR_SOURCES
  RUNNING_PAID_RESEARCH
  COMPLETED
  PARTIAL
  FAILED
}

enum SeoResearchTaskKind {
  DOMAIN_OVERVIEW
  BACKLINKS_OVERVIEW
  KEYWORD_SEED
}

enum SeoResearchTaskStatus {
  RESERVED
  ATTEMPTING
  COMPLETED
  FAILED
  UNCERTAIN
}

enum ArticleKeywordResearchStatus {
  REQUESTED
  ATTEMPTING
  COMPLETED
  FAILED
  UNCERTAIN
}

enum ArticleKeywordResearchKind {
  RELATED_KEYWORDS
  KEYWORD_OVERVIEW
  ORGANIC_SERP
}
